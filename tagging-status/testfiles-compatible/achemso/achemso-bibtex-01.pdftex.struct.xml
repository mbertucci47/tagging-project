        <?MarkedContent page="1" ?>
        <Reference xmlns="http://iso.org/pdf/ssn"
          >
          <?References objects="8" ?>
         <?MarkedContent page="1" ?>9
        </Reference>
        <?MarkedContent page="1" ?>
       </text-fragment>
       <?MarkedContent page="1" ?>
      </text-block>
     </semantic-para>
