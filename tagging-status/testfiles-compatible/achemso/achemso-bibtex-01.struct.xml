         rolemaps-to="P"
        >
       <?MarkedContent page="1" ?>The class also handles notes to be added to the bibliography. These should be given in place in the document.
       <text-fragment xmlns="https://www.latex-project.org/ns/dflt"
          xmlns:Layout="http://iso.org/pdf/ssn/Layout"
          Layout:TextPosition="Sup"
          rolemaps-to="Span"
         >
        <Reference xmlns="http://iso.org/pdf/ssn"
          >
          <?References objects="7" ?>
         <Link xmlns="http://iso.org/pdf2/ssn"
           >
          <?MarkedContent page="1" ?>8
          <?ReferencedObject type="Annot" page="1" ?>
         </Link>
        </Reference>
       </text-fragment>
       <?MarkedContent page="1" ?> As with citations, the text should be placed before punctuation. A note is also generated if a citation has an optional note. This assumes that the whole work has already been cited: odd numbering will result if this is not the case.
       <text-fragment xmlns="https://www.latex-project.org/ns/dflt"
          xmlns:Layout="http://iso.org/pdf/ssn/Layout"
