         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:TextAlign="Justify"
         rolemaps-to="P"
        >
       <?MarkedContent page="1" ?>Multiple citations to be combined into a list can be given as a single cita
       <?MarkedContent page="1" ?>tion. This uses the mciteplus package.
       <text-fragment xmlns="https://www.latex-project.org/ns/dflt"
          xmlns:Layout="http://iso.org/pdf/ssn/Layout"
          Layout:TextPosition="Sup"
          rolemaps-to="Span"
         >
        <Reference xmlns="http://iso.org/pdf/ssn"
          >
          <?References objects="6" ?>
         <Link xmlns="http://iso.org/pdf2/ssn"
           >
          <?MarkedContent page="1" ?>7
          <?ReferencedObject type="Annot" page="1" ?>
         </Link>
        </Reference>
       </text-fragment>
       <?MarkedContent page="1" ?> Citations other than the first of the list should be indicated with a star. If the mciteplus package is not installed, the standard bibliography tools will still work but starred references will be ignored. Individual references can be referred to using \mciteSubRef: “ref. 
       <Link xmlns="http://iso.org/pdf2/ssn"
         >
        <?MarkedContent page="1" ?>7.c
        <?ReferencedObject type="Annot" page="1" ?>
       </Link>
       <?MarkedContent page="1" ?>”.
      </text-block>
     </semantic-para>
     <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
