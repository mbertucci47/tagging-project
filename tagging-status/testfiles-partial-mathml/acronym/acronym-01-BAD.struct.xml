          <math xmlns="http://www.w3.org/1998/Math/MathML"> <mi>𝐿</mi> <mi>𝑂</mi> <mi>𝑋</mi> </math>
          </AssociatedFile>
          <AssociatedFile name="source.tex" relationship="Supplement" media-type="application/x-tex" xmlns="">
          $\relax LOX$
          </AssociatedFile>
         <?MarkedContent page="1" ?>𝐿𝑂𝑋
        </Formula>
        <?ReferencedObject type="Annot" page="1" ?>
       </Link>
       <?MarkedContent page="1" ?>/
       <Link xmlns="http://iso.org/pdf2/ssn"
         >
        <Formula xmlns="http://iso.org/pdf2/ssn"
           title="math"
           af="mathml-4.xml source.tex"
           xmlns:Layout="http://iso.org/pdf/ssn/Layout"
           Layout:Placement="Inline"
          >
          <AssociatedFile name="mathml-4.xml" relationship="Supplement" media-type="application/mathml+xml" xmlns="">
