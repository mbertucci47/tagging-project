          </AssociatedFile>
          <AssociatedFile name="source.tex" relationship="Supplement" media-type="application/x-tex" xmlns="">
          $\relax LH_2$
          </AssociatedFile>
         <?MarkedContent page="1" ?>𝐿𝐻2
        </Formula>
        <?ReferencedObject type="Annot" page="1" ?>
       </Link>
       <?MarkedContent page="1" ?>)
      </text-block>
     </semantic-para>
     <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
        rolemaps-to="Part"
       >
      <text-block xmlns="https://www.latex-project.org/ns/dflt"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:TextAlign="Justify"
         rolemaps-to="P"
        >
       <?MarkedContent page="1" ?>Lepton flavor violating processs (
       <Link xmlns="http://iso.org/pdf2/ssn"
         >
        <?MarkedContent page="1" ?>LFVP
        <?ReferencedObject type="Annot" page="1" ?>
       </Link>
       <?MarkedContent page="1" ?>s) are processes in which the lepton number of the initial and final states are different. An example for an 
       <Link xmlns="http://iso.org/pdf2/ssn"
         >
        <?MarkedContent page="1" ?>LFVP
        <?ReferencedObject type="Annot" page="1" ?>
       </Link>
       <?MarkedContent page="1" ?> is neutrinoless double beta decay.
      </text-block>
     </semantic-para>
