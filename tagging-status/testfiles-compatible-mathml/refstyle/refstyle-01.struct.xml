      \begin {align}&amp;\mathrm {e}^z = \mathrm {e}^x \left (\cos y + \mathrm {i} \sin y \right ) \eqlabel {e1}\\ &amp;z^\alpha = \mathrm {e}^{\alpha \ln z} \eqlabel {e2}\\ \intertext {\Eqref {e1,e2} lead to the following interesting results:} &amp;\mathrm {e}^{\mathrm {i} \pi } + 1 = 0 \eqlabel {e3}\\ &amp;\mathrm {i}^\mathrm {i} = \mathrm {e}^{-\pi /2}\tag {\textasteriskcentered } \eqlabel {e4}\end {align}
      </AssociatedFile>
