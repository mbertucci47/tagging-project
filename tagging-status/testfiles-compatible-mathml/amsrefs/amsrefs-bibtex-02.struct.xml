       <AssociatedFile name="mathml-2.xml" relationship="Supplement" media-type="application/mathml+xml" xmlns="">
       <math xmlns="http://www.w3.org/1998/Math/MathML"> <mi>𝑞</mi> </math>
       </AssociatedFile>
       <AssociatedFile name="source.tex" relationship="Supplement" media-type="application/x-tex" xmlns="">
       $q$
       </AssociatedFile>
      <?MarkedContent page="1" ?>𝑞
     </Formula>
     <?MarkedContent page="1" ?> splitting obstruction ….
    </text-block>
   </semantic-para>
   <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
      rolemaps-to="Part"
     >
    <text-block xmlns="https://www.latex-project.org/ns/dflt"
       xmlns:Layout="http://iso.org/pdf/ssn/Layout"
       Layout:TextAlign="Justify"
       rolemaps-to="P"
      >
     <?MarkedContent page="1" ?>… following the work of Cohen [
     <Link xmlns="http://iso.org/pdf2/ssn"
       >
      <?MarkedContent page="1" ?>2
      <?ReferencedObject type="Annot" page="1" ?>
     </Link>
     <?MarkedContent page="1" ?>] on 
     <Formula xmlns="http://iso.org/pdf2/ssn"
        title="math"
        af="mathml-4.xml source.tex"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:Placement="Inline"
       >
       <AssociatedFile name="mathml-4.xml" relationship="Supplement" media-type="application/mathml+xml" xmlns="">
       <math xmlns="http://www.w3.org/1998/Math/MathML"> <mi>𝑃</mi> <mi>𝐿</mi> </math>
       </AssociatedFile>
       <AssociatedFile name="source.tex" relationship="Supplement" media-type="application/x-tex" xmlns="">
       $PL$
       </AssociatedFile>
      <?MarkedContent page="1" ?>𝑃𝐿
     </Formula>
     <?MarkedContent page="1" ?> manifold transversality.
    </text-block>
   </semantic-para>
   <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
      rolemaps-to="Part"
     >
    <text-block xmlns="https://www.latex-project.org/ns/dflt"
       xmlns:Layout="http://iso.org/pdf/ssn/Layout"
       Layout:TextAlign="Justify"
       rolemaps-to="P"
      >
     <?MarkedContent page="1" ?>In this case each inverse image is automatically a 
     <Formula xmlns="http://iso.org/pdf2/ssn"
        title="math"
        af="mathml-4.xml source.tex"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:Placement="Inline"
       >
       <AssociatedFile name="mathml-4.xml" relationship="Supplement" media-type="application/mathml+xml" xmlns="">
       <math xmlns="http://www.w3.org/1998/Math/MathML"> <mi>𝑃</mi> <mi>𝐿</mi> </math>
       </AssociatedFile>
       <AssociatedFile name="source.tex" relationship="Supplement" media-type="application/x-tex" xmlns="">
       $PL$
       </AssociatedFile>
      <?MarkedContent page="1" ?>𝑃𝐿
     </Formula>
     <?MarkedContent page="1" ?> submanifold of codi
     <?MarkedContent page="1" ?>mension 
     <Formula xmlns="http://iso.org/pdf2/ssn"
        title="math"
        af="mathml-6.xml source.tex"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:Placement="Inline"
       >
       <AssociatedFile name="mathml-6.xml" relationship="Supplement" media-type="application/mathml+xml" xmlns="">
       <math xmlns="http://www.w3.org/1998/Math/MathML"> <mi>𝜎</mi> </math>
       </AssociatedFile>
       <AssociatedFile name="source.tex" relationship="Supplement" media-type="application/x-tex" xmlns="">
       $\sigma $
       </AssociatedFile>
      <?MarkedContent page="1" ?>𝜎
     </Formula>
     <?MarkedContent page="1" ?> (Cohen [
     <Link xmlns="http://iso.org/pdf2/ssn"
       >
      <?MarkedContent page="1" ?>2
      <?ReferencedObject type="Annot" page="1" ?>
     </Link>
     <?MarkedContent page="1" ?>]), so there is no need to use 
     <Formula xmlns="http://iso.org/pdf2/ssn"
        title="math"
        af="mathml-7.xml source.tex"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:Placement="Inline"
       >
       <AssociatedFile name="mathml-7.xml" relationship="Supplement" media-type="application/mathml+xml" xmlns="">
       <math xmlns="http://www.w3.org/1998/Math/MathML"> <mi>𝑠</mi> </math>
       </AssociatedFile>
       <AssociatedFile name="source.tex" relationship="Supplement" media-type="application/x-tex" xmlns="">
       $s$
       </AssociatedFile>
      <?MarkedContent page="1" ?>𝑠
     </Formula>
     <?MarkedContent page="1" ?>-cobordisms.
    </text-block>
   </semantic-para>
   <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
      rolemaps-to="Part"
     >
    <text-block xmlns="https://www.latex-project.org/ns/dflt"
       xmlns:Layout="http://iso.org/pdf/ssn/Layout"
